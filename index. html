    <!-- CORE APPLICATION JAVASCRIPT STATE ENGINE -->
    <script>
        // State management
        let currentUser = null;
        let walletBalance = 0;
        let transactions = [];

        document.addEventListener('DOMContentLoaded', () => {
            // Restore persistent session if present
            const storedUser = localStorage.getItem('biqsolo_user');
            const storedBalance = localStorage.getItem('biqsolo_balance');
            const storedHistory = localStorage.getItem('biqsolo_history');

            if (storedUser) {
                currentUser = JSON.parse(storedUser);
                walletBalance = storedBalance ? parseFloat(storedBalance) : 0;
                transactions = storedHistory ? JSON.parse(storedHistory) : [];
                renderAuthenticatedState();
            }
        });

        // Navigation and Auth Switches
        function openAuthModal(mode) {
            document.getElementById('authModal').classList.remove('hidden');
            switchTab(mode);
        }

        function closeAuthModal() {
            document.getElementById('authModal').classList.add('hidden');
        }

        function switchTab(mode) {
            const loginForm = document.getElementById('loginForm');
            const signupForm = document.getElementById('signupForm');
            const tabLogin = document.getElementById('tabLogin');
            const tabSignup = document.getElementById('tabSignup');

            if (mode === 'login') {
                loginForm.classList.remove('hidden');
                signupForm.classList.add('hidden');
                tabLogin.className = "flex-1 py-3 text-center text-sm font-bold text-brand-500 border-b-2 border-brand-500";
                tabSignup.className = "flex-1 py-3 text-center text-sm font-bold text-slate-400 border-b-2 border-transparent";
            } else {
                signupForm.classList.remove('hidden');
                loginForm.classList.add('hidden');
                tabSignup.className = "flex-1 py-3 text-center text-sm font-bold text-brand-500 border-b-2 border-brand-500";
                tabLogin.className = "flex-1 py-3 text-center text-sm font-bold text-slate-400 border-b-2 border-transparent";
            }
        }

        function handleAuthSubmit(event, type) {
            event.preventDefault();
            const email = type === 'login' ? document.getElementById('loginEmail').value : document.getElementById('signupEmail').value;
            const name = type === 'signup' ? document.getElementById('signupName').value : 'Client';

            currentUser = { email, name };
            localStorage.setItem('biqsolo_user', JSON.stringify(currentUser));
            
            if (!localStorage.getItem('biqsolo_balance')) {
                walletBalance = 0;
                localStorage.setItem('biqsolo_balance', walletBalance);
            }

            closeAuthModal();
            renderAuthenticatedState();
        }

        function renderAuthenticatedState() {
            document.getElementById('publicView').classList.add('hidden');
            document.getElementById('publicNav').classList.add('hidden');

            document.getElementById('dashboardView').classList.remove('hidden');
            document.getElementById('dashboardNav').classList.remove('hidden');

            document.getElementById('securityAlert').classList.remove('hidden');
            document.getElementById('userDisplayEmail').textContent = currentUser.email;
            document.getElementById('navUserBadge').textContent = currentUser.email;

            updateWalletUI();
        }

        function logout() {
            localStorage.removeItem('biqsolo_user');
            currentUser = null;
            window.location.reload();
        }

        // Wallet Logic
        function updateWalletUI() {
            document.getElementById('walletBalanceDisplay').textContent = walletBalance.toLocaleString();
            localStorage.setItem('biqsolo_balance', walletBalance);
            localStorage.setItem('biqsolo_history', JSON.stringify(transactions));
        }

        function openDepositModal() {
            document.getElementById('depositModal').classList.remove('hidden');
        }

        function closeDepositModal() {
            document.getElementById('depositModal').classList.add('hidden');
        }

        function switchDepositMethod(method) {
            const cardForm = document.getElementById('cardDepositForm');
            const transferView = document.getElementById('transferDepositView');
            const tabCard = document.getElementById('depositTabCard');
            const tabTransfer = document.getElementById('depositTabTransfer');

            if (method === 'card') {
                cardForm.classList.remove('hidden');
                transferView.classList.add('hidden');
                tabCard.className = "flex-1 py-2.5 text-center text-xs sm:text-sm font-bold text-brand-500 border-b-2 border-brand-500 flex items-center justify-center gap-2";
                tabTransfer.className = "flex-1 py-2.5 text-center text-xs sm:text-sm font-bold text-slate-400 border-b-2 border-transparent flex items-center justify-center gap-2";
            } else {
                transferView.classList.remove('hidden');
                cardForm.classList.add('hidden');
                tabTransfer.className = "flex-1 py-2.5 text-center text-xs sm:text-sm font-bold text-brand-500 border-b-2 border-brand-500 flex items-center justify-center gap-2";
                tabCard.className = "flex-1 py-2.5 text-center text-xs sm:text-sm font-bold text-slate-400 border-b-2 border-transparent flex items-center justify-center gap-2";
            }
        }

        function processCardDeposit(event) {
            event.preventDefault();
            const amount = parseFloat(document.getElementById('depositAmountCard').value);
            executeDeposit(amount, 'Debit Card Deposit');
        }

        function processTransferDeposit(event) {
            event.preventDefault();
            const amount = parseFloat(document.getElementById('depositAmountTransfer').value);
            executeDeposit(amount, 'Bank Transfer Credit');
        }

        function executeDeposit(amount, type) {
            walletBalance += amount;
            transactions.unshift({
                type: type,
                amount: `+₦${amount.toLocaleString()}`,
                date: new Date().toLocaleString(),
                status: 'Successful'
            });
            updateWalletUI();
            closeDepositModal();
            alert(`Success! ₦${amount.toLocaleString()} deposited into your digital wallet.`);
        }

        // Service Checkout
        function payWithWallet(serviceName, price) {
            if (walletBalance < price) {
                alert(`Insufficient wallet balance! You need ₦${price.toLocaleString()} but currently have ₦${walletBalance.toLocaleString()}. Please click 'Deposit Funds' to top up.`);
                openDepositModal();
                return;
            }

            if (confirm(`Confirm payment of ₦${price.toLocaleString()} for '${serviceName}' from your wallet?`)) {
                walletBalance -= price;
                transactions.unshift({
                    type: `Service: ${serviceName}`,
                    amount: `-₦${price.toLocaleString()}`,
                    date: new Date().toLocaleString(),
                    status: 'Completed'
                });
                updateWalletUI();

                const waMessage = `Hello Biqsolo Digital, I have successfully paid ₦${price.toLocaleString()} for '${serviceName}' using my Client Wallet (${currentUser.email}). Please confirm receipt and begin my project!`;
                window.open(`https://wa.me/2348077157441?text=${encodeURIComponent(waMessage)}`, '_blank');
            }
        }

        // History Modal Logic
        function openHistoryModal() {
            const listContainer = document.getElementById('historyList');
            if (transactions.length === 0) {
                listContainer.innerHTML = `<div class="text-center py-8 text-slate-500">No transactions recorded yet.</div>`;
            } else {
                listContainer.innerHTML = transactions.map(t => `
                    <div class="bg-slate-950 p-3.5 rounded-2xl border border-slate-800 flex items-center justify-between">
                        <div>
                            <span class="font-bold text-white block">${t.type}</span>
                            <span class="text-[10px] text-slate-500">${t.date}</span>
                        </div>
                        <div class="text-right">
                            <span class="font-black ${t.amount.startsWith('+') ? 'text-brand-500' : 'text-slate-200'}">${t.amount}</span>
                            <span class="block text-[10px] text-emerald-400 font-semibold">${t.status}</span>
                        </div>
                    </div>
                `).join('');
            }
            document.getElementById('historyModal').classList.remove('hidden');
        }

        function closeHistoryModal() {
            document.getElementById('historyModal').classList.add('hidden');
        }

        // Assistant Widget
        function toggleChatAssistant() {
            document.getElementById('chatAssistantModal').classList.toggle('hidden');
        }

        function sendAssistantQuery(type) {
            const chatMessages = document.getElementById('chatMessages');

            if (type === 'Delivery Time') {
                chatMessages.innerHTML += `
